{
  "name": "academy-course-edit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "会员空间平台 · 工作台学院课程编辑页（React + TypeScript + TDesign，mock 接口）",
  "scripts": {
    "dev": "vite --port 5199 --strictPort",
